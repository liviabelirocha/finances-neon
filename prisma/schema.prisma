generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id             String            @id @default(uuid())
  name           String
  Integration    BoardIntegration?
  ExpectedIncome ExpectedIncome[]
  Tag            Tag[]
  Transaction    Transaction[]
  UserBoard      UserBoard[]
}

model UserBoard {
  id      String @id @default(uuid())
  userId  String
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String            @id @default(uuid())
  name      String
  type      TransactionType
  amount    Int
  tagId     String?
  boardId   String
  date      DateTime          @default(now())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  method    TransactionMethod @default(OTHER)
  recurring Boolean?          @default(false)
  board     Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tag       Tag?              @relation(fields: [tagId], references: [id])
}

model Tag {
  id          String        @id @default(uuid())
  name        String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  boardId     String
  board       Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  Transaction Transaction[]
}

model BoardIntegration {
  id                   String    @id @default(uuid())
  boardId              String    @unique
  auvpApiKey           String?
  auvpValidatedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// AUVP tags and budgets ("metas") whose transactions the daily budget doesn't count.
  auvpIgnoredTagIds    Int[]     @default([])
  auvpIgnoredBudgetIds Int[]     @default([])
  board                Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

/// Income the user expects to receive in a month (amount in cents); month is 0-11.
model ExpectedIncome {
  id        String   @id @default(uuid())
  boardId   String
  year      Int
  month     Int
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, year, month])
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
  INVESTMENT_WITHDRAWAL
}

enum TransactionMethod {
  PIX
  CARD
  CASH
  OTHER
}
